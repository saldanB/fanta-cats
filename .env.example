# Copy this file to .env and fill in the real value.
# How to get it: open fantacalcio.it logged in -> DevTools -> Network tab ->
# click a download button (e.g. "Statistiche") -> click the /api/v1/Excel/...
# request -> Headers -> Request Headers -> copy the full "Cookie:" value.
FANTACALCIO_AUTH=

# Only Euro Leghe votes remains unconfirmed - capture its URL from the
# Euro Leghe "Voti" download button and set it here. See README.md.
FANTACALCIO_EUROLEGHE_VOTES_URL_TEMPLATE=
